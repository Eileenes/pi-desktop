{
	"name": "pi-desktop",
	"version": "0.1.0",
	"private": true,
	"description": "An independent Electron desktop client for Pi.",
	"author": "Earendil Works",
	"type": "module",
	"main": "./dist/main/main/main.js",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "npm run build:main && npm run build:renderer",
		"build:main": "tsgo -p tsconfig.main.json",
		"build:renderer": "vite build",
		"check": "biome check . && npm run build && node scripts/check-build-artifacts.mjs && tsgo --noEmit -p tsconfig.check.json && tsgo --noEmit -p tsconfig.renderer.json",
		"start": "npm run build && electron .",
		"package": "npm run build && electron-builder",
		"package:mac": "npm run build && electron-builder --mac --publish never",
		"package:win": "npm run build && electron-builder --win --publish never",
		"package:linux": "npm run build && electron-builder --linux --publish never",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@lobehub/icons": "5.16.0",
		"electron-updater": "6.6.2",
		"highlight.js": "10.7.3",
		"katex": "0.16.47",
		"mammoth": "1.12.0",
		"marked": "18.0.5",
		"mermaid": "11.14.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@vitejs/plugin-react": "6.1.0",
		"electron": "44.0.0",
		"electron-builder": "26.15.3",
		"typescript": "5.9.3",
		"undici-types": "8.10.0",
		"vite": "8.2.2",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"build": {
		"appId": "com.earendil.pi.desktop",
		"productName": "Pi Agent",
		"asar": true,
		"icon": "build/icon.png",
		"files": [
			"dist/**/*",
			"package.json",
			"node_modules/@earendil-works/pi-coding-agent/**/*",
			"node_modules/@earendil-works/pi-coding-agent/node_modules/**/*"
		],
		"directories": {
			"output": "release"
		},
		"publish": {
			"provider": "github",
			"owner": "Eileenes",
			"repo": "pi-desktop",
			"releaseType": "release"
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.developer-tools"
		},
		"win": {
			"target": [
				"nsis",
				"zip"
			]
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Development"
		}
	}
}
